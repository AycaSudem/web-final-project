generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  university   String?
  department   String?
  bio          String?
  createdAt    DateTime   @default(now())
  posts        Post[]
  comments     Comment[]
  likes        PostLike[]
  events       Event[]    @relation("EventCreator")
}

model Post {
  id        String     @id @default(cuid())
  userId    String
  title     String
  content   String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id])
  comments  Comment[]
  likes     PostLike[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Event {
  id            String    @id @default(cuid())
  creatorUserId String
  title         String
  description   String
  startDateTime DateTime
  endDateTime   DateTime?
  location      String
  university    String
  clubName      String
  category      String
  createdAt     DateTime  @default(now())
  creator       User      @relation("EventCreator", fields: [creatorUserId], references: [id])
}
